# Copy to .env.local and fill in. The NEXT_PUBLIC_* values are safe to expose
# (they're protected by row-level security). The SECRET is server-only.

# --- client (public, RLS-guarded) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Static fallback used until Supabase is seeded (the existing GitHub Pages site)
NEXT_PUBLIC_FALLBACK_BASE=https://flav256.github.io/kirkland-thermography

# --- server only: used by scripts/load-buildings.mjs. DO NOT prefix NEXT_PUBLIC. ---
# SUPABASE_URL=https://YOUR-REF.supabase.co
# SUPABASE_SECRET=YOUR-ROTATED-SECRET-KEY
